{
  "vhosts": [
    {
      "name": "/"
    }
  ],
  "permissions": [
    {
      "user": "guest",
      "vhost": "/",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "queues": [
    {
      "name": "notifications-user-created",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "notifications-payment-processed",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    }
  ],
  "exchanges": [
    {
      "name": "FiapCloudGames.Contracts:UserCreatedEvent",
      "vhost": "/",
      "type": "fanout",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "FiapCloudGames.Contracts:PaymentProcessedEvent",
      "vhost": "/",
      "type": "fanout",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "bindings": [
    {
      "source": "FiapCloudGames.Contracts:UserCreatedEvent",
      "vhost": "/",
      "destination": "notifications-user-created",
      "destination_type": "queue",
      "routing_key": "",
      "arguments": {}
    },
    {
      "source": "FiapCloudGames.Contracts:PaymentProcessedEvent",
      "vhost": "/",
      "destination": "notifications-payment-processed",
      "destination_type": "queue",
      "routing_key": "",
      "arguments": {}
    }
  ]
}
